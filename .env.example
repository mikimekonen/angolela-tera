# =============================================================
# ANGOLELA TERA WOREDA ADMINISTRATION PORTAL
# Environment Variables Template
# =============================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env.local for local development
#   2. For production, set these in your deployment environment
#   3. NEVER commit .env.local or .env with real values to git
#   4. Replace ALL placeholder values before first run
#
# =============================================================

# --- DATABASE ---
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://angolela_user:STRONG_PASSWORD_HERE@localhost:5432/angolela_tera_db?schema=public"

# --- APPLICATION ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Angolela Tera Woreda Administration"

# --- AUTHENTICATION ---
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM"
JWT_EXPIRY="8h"
SESSION_SECRET="REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET"
BCRYPT_ROUNDS="12"

# --- SEED ---
# Used ONLY during `prisma db seed` — change immediately after first run
SEED_ADMIN_PASSWORD="Change-This-Immediately!1"

# --- FILE UPLOADS ---
# Strategy: "local" (dev/staging) or "s3" (production)
UPLOAD_STRATEGY="local"
UPLOAD_LOCAL_DIR="./public/uploads"
UPLOAD_MAX_SIZE_MB="20"
# Allowed MIME types (comma-separated)
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# --- S3 / COMPATIBLE STORAGE (production) ---
# Leave blank if UPLOAD_STRATEGY="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- EMAIL (for contact form submissions) ---
# SMTP or transactional email service
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@angolela-tera.gov.et"
SMTP_PASS="SMTP_PASSWORD"
NOTIFY_EMAIL="admin@angolela-tera.gov.et"

# --- RATE LIMITING ---
# Requests per window per IP for public API endpoints
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"
# Stricter for contact form
CONTACT_RATE_LIMIT_MAX="5"

# --- SEARCH ---
# "database" = PostgreSQL full-text search (default, no extra service)
# "meilisearch" = MeiliSearch instance (better UX, optional)
SEARCH_STRATEGY="database"
MEILI_URL=""
MEILI_MASTER_KEY=""

# --- NEXT.JS ---
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"

# --- LOGGING ---
# "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# =============================================================
# PRODUCTION ADDITIONAL SETTINGS
# =============================================================
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://angolela-tera.gov.et"
