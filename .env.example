# =============================================================
# ANGOLELA TERA WOREDA ADMINISTRATION PORTAL
# Environment Variables Template
# =============================================================
#
# INSTRUCTIONS:
#   1. Copy this file to .env.local for local development
#   2. For production, set these in your deployment environment
#   3. NEVER commit .env.local or .env with real values to git
#   4. Replace ALL placeholder values before first run
#
# =============================================================

# --- DATABASE ---
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://angolela_user:STRONG_PASSWORD_HERE@localhost:5432/angolela_tera_db?schema=public"

# --- APPLICATION ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Angolela Tera Woreda Administration"

# --- AUTHENTICATION ---
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM"
JWT_EXPIRY="8h"
SESSION_SECRET="REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET"
BCRYPT_ROUNDS="12"

# --- SEED ---
# Used ONLY during `prisma db seed` — change immediately after first run
SEED_ADMIN_PASSWORD="Change-This-Immediately!1"

# --- FILE UPLOADS ---
# Strategy: "local" (dev/staging) or "s3" (production)
UPLOAD_STRATEGY="local"
UPLOAD_LOCAL_DIR="./public/uploads"
UPLOAD_MAX_SIZE_MB="20"
# Allowed MIME types (comma-separated)
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# --- S3 / COMPATIBLE STORAGE (production) ---
# Leave blank if UPLOAD_STRATEGY="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- EMAIL DELIVERY CONFIGURATION ---
# Option 1 (RECOMMENDED FOR VERCEL): Resend REST API (over HTTPS port 443, no socket blocks)
# Sign up at https://resend.com (free tier sends 3,000 emails/month, 100/day) and create an API Key.
# Set RESEND_API_KEY in your Vercel Dashboard > Project Settings > Environment Variables.
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Option 2: Direct SMTP Gateway (Gmail, ZeptoMail, or Custom Mail Server)
# For Gmail, generate an App Password in Google Account > Security > 2-Step Verification > App passwords.
# Note: Raw SMTP sockets on port 465/587 can occasionally be restricted by serverless cloud platforms.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="angolelatera1@gmail.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD_HERE"

# Official Woreda Destination & Sender Addresses
CONTACT_TO_EMAIL="angolelatera1@gmail.com"
# When using unverified Resend domain, default to "onboarding@resend.dev"; with custom domain use "noreply@angolela-tera.gov.et"
MAIL_FROM="Angolela Tera Woreda <onboarding@resend.dev>"

# Base URL for public links in email receipts (tracking link & admin dashboard link)
NEXT_PUBLIC_SITE_URL="https://angolela-tera.vercel.app"

# --- RATE LIMITING ---
# Requests per window per IP for public API endpoints
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"
# Stricter for contact form
CONTACT_RATE_LIMIT_MAX="5"

# --- SEARCH ---
# "database" = PostgreSQL full-text search (default, no extra service)
# "meilisearch" = MeiliSearch instance (better UX, optional)
SEARCH_STRATEGY="database"
MEILI_URL=""
MEILI_MASTER_KEY=""

# --- NEXT.JS ---
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED="1"

# --- LOGGING ---
# "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# =============================================================
# PRODUCTION ADDITIONAL SETTINGS
# =============================================================
# NODE_ENV="production"
# NEXT_PUBLIC_APP_URL="https://angolela-tera.gov.et"
